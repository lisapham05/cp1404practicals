BoxLayout:
    orientation: 'vertical'
    padding: 20
    spacing: 10

    Label:
        text: 'Enter a number to square:'

    TextInput:
        id: input_number
        text: ''
        multiline: False
        input_filter: 'float'

    Button:
        text: 'Square it!'
        on_press: app.calculate_square()

    Label:
        text: 'Result: [b]{}[/b]'.format(app.result)
        markup: True

    Button:
        text: 'Clear'
        on_press: app.clear_fields()